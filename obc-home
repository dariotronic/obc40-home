def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def icon_name(names, fallback="application-x-executable"):
    theme = Gtk.IconTheme.get_default()
    return next((n for n in names if theme.has_icon(n)), fallback)


def http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "obc-home/1.0"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read().decode())


def setup_top_panel():
    """Il pannello in alto di XFCE si nasconde da solo (scende con lo swipe sulla home) e prende i colori
    della home. Cambia le impostazioni solo se servono."""
    if not shutil.which("xfconf-query"):
        return

    def get(prop):
        return sh(f"xfconf-query -c xfce4-panel -p {prop}")

    def put(prop, *typed):        # typed: ("uint", "2") oppure più coppie per un array
        args = " ".join(f"-t {t} -s {v}" for t, v in typed)
        sh(f"xfconf-query -c xfce4-panel -p {prop} -n {args} 2>/dev/null || "
           f"xfconf-query -c xfce4-panel -p {prop} {args}")

    rgba = ("0.063", "0.067", "0.078", "1")       # #101114, lo sfondo della home
    for pid in re.findall(r"^\d+$", get("/panels"), re.M):
        base = f"/panels/panel-{pid}"
        top = get(f"{base}/position").split(";")[0] == "p=6"
        if top and get(f"{base}/autohide-behavior") != "2":
            put(f"{base}/autohide-behavior", ("uint", "2"))
        if get(f"{base}/background-style") != "1":
            put(f"{base}/background-style", ("uint", "1"))
        cur = re.findall(r"^[0-9.]+$", get(f"{base}/background-rgba"), re.M)
        if [round(float(v), 3) for v in cur] != [float(v) for v in rgba]:
            put(f"{base}/background-rgba", *[("double", v) for v in rgba])
        if top and get(f"{base}/size") != "48":
            put(f"{base}/size", ("uint", "48"))

    css_file = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
    old = read(css_file)
    block = TOP_PANEL_CSS_START + TOP_PANEL_CSS + TOP_PANEL_CSS_END
    if TOP_PANEL_CSS_START in old and TOP_PANEL_CSS_END in old:
        new = re.sub(re.escape(TOP_PANEL_CSS_START) + ".*?" + re.escape(TOP_PANEL_CSS_END),
                     lambda _m: block, old, flags=re.S)
    else:
        new = (old + "\n\n" if old else "") + block
    if new.strip() != old.strip():
        os.makedirs(os.path.dirname(css_file), exist_ok=True)
        with open(css_file, "w") as f:
            f.write(new.strip() + "\n")
        sh("xfce4-panel -r")      # il pannello rilegge gtk.css solo ripartendo


class TouchFocus:
    """Col touch il focus resta sui pulsanti toccati (bordo tratteggiato): lo si toglie subito,
    tranne che dai campi di testo. Quando la tastiera a schermo si chiude, si toglie anche da quelli."""

    def __init__(self, win):
        self.win = win
        win.connect("set-focus", self.on_set_focus)
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.signal_subscribe("org.onboard.Onboard", "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                 "/org/onboard/Onboard/Keyboard", None, Gio.DBusSignalFlags.NONE,
                                 self.on_keyboard, None)
        except GLib.Error:
            pass

    def on_set_focus(self, _win, widget):
        if widget is not None and not isinstance(widget, Gtk.Entry):
            GLib.idle_add(self.drop, False)

    def drop(self, also_entries):
        w = self.win.get_focus()
        if w is not None and (also_entries or not isinstance(w, Gtk.Entry)):
            self.win.set_focus(None)
        return False

    def on_keyboard(self, _conn, _sender, _path, _iface, _signal, params, _data):
        changed = params.unpack()[1]
        if changed.get("Visible") is False:
            GLib.idle_add(self.drop, True)


class Slot(Gtk.Overlay):
    """Un riquadro configurabile. In modalità modifica il riquadro si rimpicciolisce e oscilla
    (disegnato ruotato con cairo) e mostra i pulsanti ✕ (libera) e matita (cambia), o + se è vuoto."""

    SCALE = 0.9
    ANGLE = 3.0       # gradi
    HZ = 2.2          # oscillazioni al secondo

    def __init__(self, home, index):
        super().__init__()
        self.home, self.index = home, index
        self.big = index == 0
        self.long_pressed = False
        self.holder = Gtk.Box()
        self.holder.connect("draw", self.on_draw)
        self.add(self.holder)
        self.btn = None

        self.del_btn = self.badge("badge-del", ["window-close-symbolic"], Gtk.Align.START,
                                  lambda: self.home.clear_slot(self.index))
        self.del_btn.get_accessible().set_name("Libera il riquadro")
        self.edit_btn = self.badge("badge-edit", ["document-edit-symbolic", "edit-symbolic"], Gtk.Align.END,
                                   lambda: self.home.choose_for(self.index))
        self.edit_btn.get_accessible().set_name("Cambia il riquadro")
        self.refresh()

    def badge(self, cls, icons, halign, action):
        b = Gtk.Button(halign=halign, valign=Gtk.Align.START)
        b.get_style_context().add_class("badge"); b.get_style_context().add_class(cls)
        img = Gtk.Image.new_from_icon_name(icon_name(icons, icons[0]), Gtk.IconSize.BUTTON)
        img.set_pixel_size(20)
        img.show()                 # il pulsante ha no_show_all: l'icona va mostrata a parte
        b.add(img)
        b.connect("clicked", lambda *_: action())
        b.set_no_show_all(True)
        self.add_overlay(b)
        return b

    def refresh(self):
        view = self.home.slot_view(self.index)
        if self.btn is not None:
            self.holder.remove(self.btn)
        self.empty = view is None
        if self.empty:    # vuoto: un "+" che si vede solo in modalità modifica
            b = self.home.tile(None, ["list-add-symbolic"], None, icon_size=56 if self.big else 44)
            b.get_style_context().add_class("tile-empty")
            b.img.set_no_show_all(True)
            self.action = lambda: self.home.choose_for(self.index)
        else:
            label, icons, action = view
            b = self.home.tile(label, icons, None, icon_size=96 if self.big else 64)
            self.action = action
        b.connect("clicked", self.on_clicked)
        b.long_gesture = Gtk.GestureLongPress(widget=b)   # il riferimento deve restare vivo
        b.long_gesture.connect("pressed", self.on_long)
        self.btn = b
        self.holder.pack_start(b, True, True, 0)
        b.show_all()
        self.set_editing(self.home.editing)

    def set_editing(self, on):
        self.del_btn.set_visible(on and not self.empty)
        self.edit_btn.set_visible(on and not self.empty)
        if self.empty:
            self.btn.img.set_visible(on)
        self.holder.queue_draw()

    def on_clicked(self, *_):
        if self.long_pressed:            # il rilascio dopo una pressione lunga non fa niente
            self.long_pressed = False
            return
        if self.home.editing:
            self.home.choose_for(self.index)
        else:
            self.action()

    def on_long(self, *_):
        self.long_pressed = True
        if not self.home.editing:
            self.home.set_editing(True)

    def on_draw(self, widget, cr):
        if not self.home.editing:
            return False
        if self.home.moving and self is self.home.move_src:     # il riquadro è "nel dito": qui resta un'ombra
            cr.push_group()
            widget.propagate_draw(self.btn, cr)
            cr.pop_group_to_source()
            cr.paint_with_alpha(0.15)
            return True
        a = widget.get_allocation()
        t = self.home.wiggle_t
        phase = 0.0 if self.index % 2 else 3.14159
        angle = math.radians(self.ANGLE) * math.sin(2 * math.pi * self.HZ * t + phase)
        cr.translate(a.width / 2, a.height / 2)
        cr.rotate(angle)
        cr.scale(self.SCALE, self.SCALE)
        cr.translate(-a.width / 2, -a.height / 2)
        if self.home.moving and self is self.home.move_target:  # qui andrebbe a finire: più tenue
            cr.push_group()
            widget.propagate_draw(self.btn, cr)
            cr.pop_group_to_source()
            cr.paint_with_alpha(0.5)
        else:
            widget.propagate_draw(self.btn, cr)
        return True


