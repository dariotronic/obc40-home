    # ---------- riquadri configurabili ----------
    # valori in [tiles] slot0..slot8:  app:<file .desktop>  |  web:<url>  |  home:<funzione>  |  vuoto

    def load_slots(self):
        if self.cfg.has_section("tiles"):
            return [self.cfg.get("tiles", f"slot{i}", fallback="").strip() for i in range(SLOTS)]
        # prima volta: i riquadri di sempre (e l'app scelta in [launcher] main_app nel riquadro grande)
        main = self.cfg.get("launcher", "main_app", fallback="").strip()
        if main and not main.endswith(".desktop"):
            main += ".desktop"
        funcs = ["terminal", "files", "settings", "network", "keyboard", "desktop", "android", "poweroff"]
        if not shutil.which("boot-android"):
            funcs.remove("android")
        slots = [f"app:{main}" if main else ""] + [f"home:{f}" for f in funcs]
        return (slots + [""] * SLOTS)[:SLOTS]

    def save_slots(self):
        self.cfg["tiles"] = {f"slot{i}": v for i, v in enumerate(self.slots_cfg)}
        self.cfg.remove_section("launcher")      # sostituito da [tiles]
        self.save_cfg()

    def slot_view(self, i):
        """(etichetta, icone, azione) del riquadro i, o None se è vuoto."""
        kind, _, val = self.slots_cfg[i].partition(":")
        if kind == "app" and val:
            try:
                info = DesktopAppInfo.new(val)
            except TypeError:
                info = None
            if info is not None:
                return (info.get_display_name(), info.get_icon() or ["application-x-executable"],
                        lambda: self.launch(info))
            return (val.removesuffix(".desktop"), ["dialog-question"],
                    lambda: self.message(f"L'app {val} non è più installata."))
        if kind == "web" and val:
            icon = obc_favicon.cached(val)
            pb = None
            if icon:
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file(icon)
                except GLib.Error:
                    pb = None
            return (obc_favicon.cached_name(val) or obc_favicon.site_name(val), pb or ["applications-internet", "web-browser"],
                    lambda: self.open_url(val))
        if kind == "home" and val in FUNCS:
            if val == "android" and not shutil.which("boot-android"):
                return None
            label, icons, what = FUNCS[val]
            action = getattr(self, what) if hasattr(self, what) else (lambda: self.run(what))
            return (label, icons, action)
        return None

    def set_slot(self, i, value):
        self.slots_cfg[i] = value
        self.save_slots()
        self.slots[i].refresh()

    def clear_slot(self, i):
        self.set_slot(i, "")

    def choose_for(self, i):
        value = self.pick_tile(i)
        if value is None:
            return
        if value == "web:":
            value = self.ask_url()
            if value is None:
                return
        self.set_slot(i, value)
        if value.startswith("web:"):
            self.fetch_icon(value[4:])

    def fetch_missing_icons(self):
        for v in self.slots_cfg:
            if v.startswith("web:") and not (obc_favicon.cached(v[4:]) and obc_favicon.cached_name(v[4:])):
                self.fetch_icon(v[4:])

    def fetch_icon(self, url):
        def work():
            obc_favicon.fetch(url)            # icona e nome del sito
            GLib.idle_add(self.refresh_web, url)
        threading.Thread(target=work, daemon=True).start()

    def refresh_web(self, url):
        for i, v in enumerate(self.slots_cfg):
            if v == "web:" + url:
                self.slots[i].refresh()
        return False

    def set_editing(self, on):
        self.editing = on
        ctx = self.root.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("editing")
        for s in self.slots:
            s.set_editing(on)
        self.update_mode_btn()
        if on and not self.wiggle_id:
            start = time.monotonic()

            def step():
                self.wiggle_t = time.monotonic() - start
                for s in self.slots:
                    s.holder.queue_draw()
                return True
            self.wiggle_id = GLib.timeout_add(40, step)
        elif not on and self.wiggle_id:
            GLib.source_remove(self.wiggle_id)
            self.wiggle_id = 0

    def update_mode_btn(self):
        ctx = self.mode_btn.get_style_context()
        if self.editing:
            ctx.add_class("on")
            self.mode_img.set_from_icon_name(icon_name(["object-select-symbolic", "emblem-ok-symbolic"]),
                                             Gtk.IconSize.DIALOG)
            self.mode_btn.get_accessible().set_name("Fine modifica")
        else:
            ctx.remove_class("on")
            self.mode_img.set_from_icon_name(icon_name(["document-edit-symbolic", "edit-symbolic"]),
                                             Gtk.IconSize.DIALOG)
            self.mode_btn.get_accessible().set_name("Modifica i riquadri")
        self.mode_img.set_pixel_size(28)

    def pick_tile(self, i):
        """Elenco per scegliere il contenuto del riquadro i: sito web, funzioni della home, app installate.
        Restituisce il valore da salvare ("web:" = chiedi l'indirizzo) o None."""
        apps = {}
        for info in Gio.AppInfo.get_all():
            app_id = info.get_id()
            if app_id and info.should_show() and app_id != "obc-home.desktop":
                apps.setdefault(app_id, info)
        apps = sorted(apps.values(), key=lambda a: a.get_display_name().casefold())

        d = Gtk.Dialog(title="Scegli cosa mettere nel riquadro", transient_for=self, modal=True)
        d.set_default_size(600, 520)
        d.add_buttons("Annulla", Gtk.ResponseType.CANCEL)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, activate_on_single_click=True)
        sw.add(lst)
        box = d.get_content_area(); box.set_spacing(10); box.set_margin_top(12)
        box.set_margin_start(12); box.set_margin_end(12)
        box.pack_start(sw, True, True, 0)

        def head(text):
            row = Gtk.ListBoxRow(activatable=False, selectable=False)
            lab = Gtk.Label(label=text, xalign=0); lab.get_style_context().add_class("pick-head")
            lab.set_margin_start(6)
            row.add(lab)
            lst.add(row)

        def item(value, label, icon):
            row = Gtk.ListBoxRow()
            hb = Gtk.Box(spacing=14); hb.set_margin_top(8); hb.set_margin_bottom(8); hb.set_margin_start(6)
            if isinstance(icon, Gio.Icon):
                img = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG)
            else:
                img = Gtk.Image.new_from_icon_name(icon_name(icon), Gtk.IconSize.DIALOG)
            img.set_pixel_size(40)
            hb.pack_start(img, False, False, 0)
            hb.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            row.add(hb)
            row.value = value
            lst.add(row)

        item("web:", "Sito web…", ["applications-internet", "web-browser"])
        head("Funzioni della home")
        for fid, (label, icons, _) in FUNCS.items():
            if fid == "android" and not shutil.which("boot-android"):
                continue
            item("home:" + fid, label, icons)
        head("Applicazioni")
        for info in apps:
            item("app:" + info.get_id(), info.get_display_name(), info.get_icon() or ["application-x-executable"])

        chosen = []
        lst.connect("row-activated", lambda _l, row: (chosen.append(row.value), d.response(Gtk.ResponseType.OK)))
        d.show_all()
        d.run(); d.destroy()
        return chosen[0] if chosen else None

    def ask_url(self):
        d = Gtk.Dialog(title="Sito web", transient_for=self, modal=True)
        d.add_buttons("Annulla", Gtk.ResponseType.CANCEL, "Salva", Gtk.ResponseType.OK)
        e = Gtk.Entry(placeholder_text="esempio.it", input_purpose=Gtk.InputPurpose.URL)
        e.set_activates_default(True)
        d.set_default_response(Gtk.ResponseType.OK)
        err = Gtk.Label(xalign=0); err.get_style_context().add_class("wdesc")
        box = d.get_content_area(); box.set_spacing(10); box.set_margin_top(12)
        box.set_margin_start(12); box.set_margin_end(12)
        box.add(Gtk.Label(label="Scrivi l'indirizzo del sito:", xalign=0)); box.add(e); box.add(err)
        d.show_all()
        self.toggle_keyboard_if_hidden()
        while True:
            r = d.run()
            if r != Gtk.ResponseType.OK:
                d.destroy(); self.hide_keyboard()
                return None
            url = obc_favicon.normalize(e.get_text())
            if url:
                d.destroy(); self.hide_keyboard()
                return "web:" + url
            err.set_text("Indirizzo non valido")

    def open_url(self, url):
        try:
            Gio.AppInfo.launch_default_for_uri(url, None)
            return
        except GLib.Error:
            pass
        for cmd in (["exo-open", "--launch", "WebBrowser", url], ["xdg-open", url]):
            if shutil.which(cmd[0]):
                subprocess.Popen(cmd, start_new_session=True)
                return
        self.message("Nessun browser installato per aprire " + url)

    def launch(self, info):
        try:
            info.launch([], None)
        except GLib.Error as e:
            self.message(f"Impossibile avviare {info.get_display_name()}: {e.message}")

    # ---------- spostamento dei riquadri (modalità modifica) ----------

    def slot_at(self, x, y):
        for s in self.slots:
            sx, sy = s.translate_coordinates(self, 0, 0)
            if sx <= x < sx + s.get_allocated_width() and sy <= y < sy + s.get_allocated_height():
                return s
        return None

    def on_move_begin(self, gesture, x, y):
        self.move_src = self.slot_at(x, y)
        self.move_start = (x, y)

    def on_move_update(self, gesture, dx, dy):
        src = self.move_src
        if src is None or not self.editing:      # (con la pressione lunga si entra in modifica a metà gesto)
            return
        if not self.moving:
            if math.hypot(dx, dy) < 18:
                return
            self.moving = True
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)   # niente clic sul riquadro
            src.del_btn.hide(); src.edit_btn.hide()
        self.move_delta = (dx, dy)
        target = self.slot_at(self.move_start[0] + dx, self.move_start[1] + dy)
        self.move_target = target if target is not src else None
        self.overlay.queue_draw()

    def on_move_end(self, gesture, dx, dy):
        src, target, was_moving = self.move_src, self.move_target, self.moving
        self.moving = False
        self.move_src = self.move_target = None
        self.overlay.queue_draw()
        if not was_moving or src is None:
            return
        src.long_pressed = False
        if target is not None:
            a, b = src.index, target.index
            self.slots_cfg[a], self.slots_cfg[b] = self.slots_cfg[b], self.slots_cfg[a]
            self.save_slots()
            # i riquadri si ricreano a gesto finito (il pulsante sotto il dito riceve ancora eventi)
            GLib.idle_add(lambda: (src.refresh(), target.refresh()) and False)
        else:
            src.set_editing(self.editing)

    def on_move_layer_draw(self, area, cr):
        if not self.moving or self.move_src is None:
            return False
        btn = self.move_src.btn
        bx, by = btn.translate_coordinates(area, 0, 0)
        cr.save()
        w, h = btn.get_allocated_width(), btn.get_allocated_height()
        cr.translate(bx + self.move_delta[0] + w / 2, by + self.move_delta[1] + h / 2)
        cr.scale(1.05, 1.05)
        cr.translate(-w / 2, -h / 2)
        btn.draw(cr)
        cr.restore()
        return False

    # ---------- pannello in alto (swipe) ----------

    def on_swipe_update(self, gesture, dx, dy):
        if self.editing:              # in modalità modifica il dito sposta i riquadri
            return
        if self.swipe_dir == 0 and abs(dy) > 60 and abs(dy) > 2 * abs(dx):
            self.swipe_dir = 1 if dy > 0 else -1
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)    # niente clic sul riquadro sotto il dito

    def on_swipe_end(self, gesture, dx, dy):
        d, self.swipe_dir = self.swipe_dir, 0
        if d:
            # il pannello si nasconde da solo ("nascondi sempre") e scende quando il puntatore tocca il bordo
            # in alto: si sposta il puntatore lì; lontano dal bordo, il pannello risale
            GLib.timeout_add(50, self.warp_pointer, 1 if d > 0 else 300)

    def warp_pointer(self, y):
        # x: a un terzo della larghezza, di solito una parte vuota del pannello (niente suggerimenti)
        geo = self.get_display().get_monitor_at_window(self.get_window()).get_geometry()
        seat = self.get_display().get_default_seat()
        seat.get_pointer().warp(self.get_screen(), geo.x + geo.width // 3, geo.y + y)
        return False

    # ---------- costruzione ----------

    def tile(self, label, icons, action, icon_size=64):
        """Pulsante-riquadro: icona (nome/i dal tema, Gio.Icon o GdkPixbuf) ed etichetta (None = nessuna)."""
        b = Gtk.Button(); b.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, valign=Gtk.Align.CENTER)
        if isinstance(icons, GdkPixbuf.Pixbuf):  # icona di un sito web
            k = icon_size / max(icons.get_width(), icons.get_height())
            pb = icons.scale_simple(round(icons.get_width() * k), round(icons.get_height() * k),
                                    GdkPixbuf.InterpType.HYPER)
            img = Gtk.Image.new_from_pixbuf(pb)
        elif isinstance(icons, Gio.Icon):        # icona di un'app installata (file .desktop)
            img = Gtk.Image.new_from_gicon(icons, Gtk.IconSize.DIALOG)
        else:
            img = Gtk.Image.new_from_icon_name(icon_name(icons), Gtk.IconSize.DIALOG)
        if not isinstance(icons, GdkPixbuf.Pixbuf):
            img.set_pixel_size(icon_size)
        box.pack_start(img, False, False, 0)
        if label is not None:
            lab = Gtk.Label(label=label, ellipsize=3, max_width_chars=14)   # 3 = Pango.EllipsizeMode.END
            box.pack_start(lab, False, False, 0)
        b.add(box)
        b.img = img
        if action is not None:
            b.connect("clicked", lambda *_: action())
        return b

    def status_item(self, bar, icon):
        box = Gtk.Box(spacing=6)
        img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
        img.set_pixel_size(20)
        lab = Gtk.Label(ellipsize=3); lab.get_style_context().add_class("status")   # 3 = END: si accorcia se non ci sta
        box.pack_start(img, False, False, 0)
        box.pack_start(lab, False, False, 0)
        bar.pack_start(box, False, False, 0)
        return lab

    # ---------- aggiornamenti ----------

    def tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", t))
        self.date.set_text(f"{GIORNI[t.tm_wday]} {t.tm_mday} {MESI[t.tm_mon - 1]}")
        return True

    def refresh_status(self):
        def work():
            wifi = sh("LC_ALL=C nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi list --rescan no | grep '^yes' | head -1")
            if wifi:
                parts = wifi.split(":")
                wifi = f"{':'.join(parts[1:-1])}  {parts[-1]}%"
            else:
                wifi = "non connesso"
            ip = sh("ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -1") or "-"
            cap = read("/sys/class/power_supply/battery1/capacity", "?")
            st = read("/sys/class/power_supply/battery1/status")
            batt = f"{cap}%" + ("  in carica" if st == "Charging" else "")
            try:
                temp = f"{int(read('/sys/class/thermal/thermal_zone0/temp', '0')) / 1000:.0f} °C"
            except ValueError:
                temp = "-"
            up = int(float(read("/proc/uptime", "0").split()[0]))
            upt = f"acceso da {up // 3600} h {up % 3600 // 60} min" if up >= 3600 else f"acceso da {up // 60} min"
            GLib.idle_add(self.set_status, wifi, ip, batt, temp, upt)
        threading.Thread(target=work, daemon=True).start()
        return True

    def set_status(self, wifi, ip, batt, temp, upt):
        self.s_wifi.set_text(wifi); self.s_ip.set_text(ip); self.s_batt.set_text(batt)
        self.s_temp.set_text(temp); self.s_up.set_text(upt)
        return False

    def refresh_weather(self):
        city = self.cfg.get("meteo", "citta", fallback="").strip()
        if not city:
            return True

        def work():
            try:
                lat = self.cfg.get("meteo", "lat", fallback="")
                lon = self.cfg.get("meteo", "lon", fallback="")
                if not lat or not lon:
                    g = http_json("https://geocoding-api.open-meteo.com/v1/search?count=1&language=it&name="
                                  + urllib.parse.quote(city))
                    if not g.get("results"):
                        GLib.idle_add(self.set_weather, None, "Città non trovata", city, "dialog-question")
                        return
                    r = g["results"][0]
                    lat, lon = str(r["latitude"]), str(r["longitude"])
                    self.cfg["meteo"]["lat"], self.cfg["meteo"]["lon"] = lat, lon
                    self.cfg["meteo"]["citta"] = r.get("name", city)
                    self.save_cfg()
                w = http_json(
                    f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
                    "&current=temperature_2m,weather_code&daily=temperature_2m_max,temperature_2m_min"
                    "&timezone=auto&forecast_days=1")
                code = int(w["current"]["weather_code"])
                desc, icon = METEO.get(code, ("", "weather-few-clouds"))
                tmax = round(w["daily"]["temperature_2m_max"][0])
                tmin = round(w["daily"]["temperature_2m_min"][0])
                name = self.cfg.get("meteo", "citta")
                GLib.idle_add(self.set_weather, round(w["current"]["temperature_2m"]), desc,
                              f"{name}  ·  {tmin}° / {tmax}°", icon)
            except Exception:
                GLib.idle_add(self.set_weather, None, "Meteo non disponibile", city, "network-offline")
        threading.Thread(target=work, daemon=True).start()
        return True

    def set_weather(self, temp, desc, small, icon):
        self.wtemp.set_text(f"{temp}°" if temp is not None else "--°")
        self.wdesc.set_text(desc); self.wsmall.set_text(small)
        theme = Gtk.IconTheme.get_default()
        self.wicon.set_from_icon_name(icon if theme.has_icon(icon) else "weather-few-clouds", Gtk.IconSize.DIALOG)
        self.wicon.set_pixel_size(72)
        return False

    def save_cfg(self):
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            self.cfg.write(f)

    # ---------- azioni ----------

    def run(self, cmd):
        try:
            subprocess.Popen(cmd.split(), start_new_session=True)
        except OSError as e:
            self.message(f"Impossibile avviare {cmd}: {e}")

    def toggle_keyboard(self):
        self.run("dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard "
                 "org.onboard.Onboard.Keyboard.ToggleVisible")

    def show_desktop(self):
        self.iconify()

    def confirm(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.YES_NO, text=text)
        r = d.run(); d.destroy()
        return r == Gtk.ResponseType.YES

    def message(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.OK, text=text)
        d.run(); d.destroy()

    def boot_android(self):
        if self.confirm("Riavviare in Android?\nLa scheda si spegnerà: riaccendila con il tasto."):
            self.run("boot-android")

    def poweroff(self):
        if self.confirm("Spegnere la scheda?"):
            self.run("sudo -n /sbin/poweroff")

    def ask_city(self, *_):
        d = Gtk.Dialog(title="Città per il meteo", transient_for=self, modal=True)
        d.add_buttons("Annulla", Gtk.ResponseType.CANCEL, "Salva", Gtk.ResponseType.OK)
        e = Gtk.Entry(text=self.cfg.get("meteo", "citta", fallback=""))
        e.set_activates_default(True)
        d.set_default_response(Gtk.ResponseType.OK)
        box = d.get_content_area(); box.set_spacing(10); box.set_margin_top(12)
        box.set_margin_start(12); box.set_margin_end(12)
        box.add(Gtk.Label(label="Scrivi il nome della città:", xalign=0)); box.add(e)
        d.show_all()
        self.toggle_keyboard_if_hidden()
        r = d.run(); city = e.get_text().strip(); d.destroy(); self.hide_keyboard()
        if r == Gtk.ResponseType.OK and city:
            self.cfg["meteo"] = {"citta": city}
            self.save_cfg()
            self.set_weather(None, "Aggiorno…", city, "weather-few-clouds")
            self.refresh_weather()

    def toggle_keyboard_if_hidden(self):
        self.run("dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard "
                 "org.onboard.Onboard.Keyboard.Show")

    def hide_keyboard(self):
        self.run("dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard "
                 "org.onboard.Onboard.Keyboard.Hide")


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="it.dario.obchome", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-application-prefer-dark-theme", True)
        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        upd = Gio.SimpleAction.new("check-updates", None)   # per i test, via D-Bus
        upd.connect("activate", lambda *_: self.win and self.win.check_updates())
        self.add_action(upd)

    def do_activate(self):
        if self.win is None:
            self.win = Home(self)
            self.win.show_all()
            self.win.maximize()
        else:
            self.win.deiconify()
            self.win.present()


